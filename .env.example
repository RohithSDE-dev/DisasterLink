# PostgreSQL connection used by Drizzle ORM (server-side only)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: enable secure cookies outside local development
# NODE_ENV=production

# No third-party API keys are required:
# - weather is fetched server-side from Open-Meteo (keyless, free)
# - AI analysis runs locally as a deterministic heuristic model

# ---------------------------------------------------------------------------
# Weather provider (Phase 2) — all server-side only, never NEXT_PUBLIC_*
# ---------------------------------------------------------------------------
# Provider credentials are optional: Open-Meteo is keyless for this prototype.
# If you switch OPEN_METEO_BASE_URL to a keyed commercial endpoint, set
# OPEN_METEO_API_KEY here. It is read in src/lib/weather.ts on the server and is
# never included in API responses or the browser bundle.
# OPEN_METEO_API_KEY=
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# WEATHER_CACHE_TTL_MINUTES=15
# WEATHER_TIMEOUT_MS=9000
